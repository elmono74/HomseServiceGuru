---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { services, telHref } from "../data/services";

// Content from the old WordPress Contact Us page, reworded where it made claims about
// providers (largest network, best providers, 24/7). The form posts to /api/contact
// (worker/index.ts), which emails it through Cloudflare Email Sending.
const withPhone = services.filter((s) => s.phone);
const times = ["Morning (8am–12pm)", "Afternoon (12pm–4pm)", "Evening (4pm–8pm)", "Any time"];
const reasons = [
  { icon: "pin", title: "Local Partners", text: "We connect you with service providers in your area." },
  { icon: "handshake", title: "Any Size Job", text: "From a quick repair to a full remodel, one call gets you started." },
  { icon: "phone-call", title: "Call Today", text: "Why wait for your problems to get bigger? Call now." },
];
---

<Base
  title="Contact Us | Home Services Guru"
  description="Request a callback or get in touch with Home Services Guru. For the fastest help, call the number for the service you need."
>
  <section class="hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span> <span aria-current="page">Contact us</span>
      </nav>
      <span class="eyebrow">Let's work together</span>
      <h1>Need fast <span class="hl">assistance?</span></h1>
      <p class="lede">
        Navigate to the page for the service you need and call to speak to a specialist now. Or send us a message and
        we'll call you back.
      </p>
    </div>
  </section>

  <section class="section body">
    <div class="wrap grid">
      <div class="form-card">
        <h2>Request a callback</h2>
        <p class="hint">Fields marked * are required.</p>
        <form id="contact-form" action="/api/contact" method="post" novalidate>
          <div class="hp" aria-hidden="true">
            <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <div class="fields">
            <label>
              <span>Name *</span>
              <input type="text" name="name" autocomplete="name" required maxlength="200" />
            </label>
            <label>
              <span>Phone *</span>
              <input type="tel" name="phone" autocomplete="tel" required maxlength="50" />
            </label>
            <label class="full">
              <span>Email *</span>
              <input type="email" name="email" autocomplete="email" required maxlength="254" />
            </label>
            <label class="full">
              <span>Service</span>
              <select name="service">
                <option value="">Choose a service…</option>
                {services.map((s) => <option value={s.name}>{s.name}</option>)}
                <option value="Something else">Something else</option>
              </select>
            </label>
            <label>
              <span>Preferred date</span>
              <input type="date" name="date" />
            </label>
            <label>
              <span>Preferred time</span>
              <select name="time">
                <option value="">Any</option>
                {times.map((t) => <option value={t}>{t}</option>)}
              </select>
            </label>
            <label class="full">
              <span>Message</span>
              <textarea name="message" rows="5" maxlength="5000" placeholder="Tell us what's going on"></textarea>
            </label>
          </div>
          <p class="status" role="status" aria-live="polite"></p>
          <button class="btn btn-call btn-lg" type="submit"><Icon name="arrow" /> Send message</button>
          <p class="fine">
            By sending this form you agree to be contacted about your request. See our <a href="/privacy-policy-3/"
              >Privacy Policy</a
            >.
          </p>
        </form>
      </div>

      <aside class="side">
        <div class="info">
          <h2>Get in touch</h2>
          <ul>
            <li><Icon name="pin" size={20} /> 530 S Lake St #250, Pasadena, CA 91101</li>
            <li>
              <Icon name="chat" size={20} /> <a href="mailto:info@homeservices.guru">info@homeservices.guru</a>
            </li>
          </ul>
        </div>
        <div class="info">
          <h2>Call a pro now</h2>
          <ul class="phones">
            {
              withPhone.map((s) => (
                <li>
                  <a href={`/services/${s.slug}/`}>{s.name}</a>
                  <a class="tel" href={telHref(s.phone!)}>
                    {s.phoneDisplay}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section reasons">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow">Why choose Home Services Guru</span>
        <h2>One call connects you with a local specialist.</h2>
      </div>
      <ul class="reason-grid">
        {
          reasons.map((r) => (
            <li>
              <span class="r-icon">
                <Icon name={r.icon} />
              </span>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  if (form) {
    const status = form.querySelector<HTMLElement>(".status")!;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const params = new URLSearchParams(location.search);

    // Callback buttons link here with ?service=<name>; the no-JS fallback returns with ?sent=1 or 0.
    const service = params.get("service");
    const select = form.querySelector<HTMLSelectElement>("select[name=service]")!;
    if (service && [...select.options].some((o) => o.value === service)) select.value = service;
    if (params.get("sent") === "1") show("Thanks! Your message was sent. We'll be in touch soon.", "ok");
    if (params.get("sent") === "0") show("Sorry, your message couldn't be sent. Please try again.", "error");

    function show(text: string, kind: "ok" | "error") {
      status.textContent = text;
      status.dataset.kind = kind;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      form.querySelectorAll("[aria-invalid]").forEach((el) => el.removeAttribute("aria-invalid"));
      const missing = [...form.querySelectorAll<HTMLInputElement>("[required]")].filter((el) => !el.checkValidity());
      if (missing.length) {
        missing.forEach((el) => el.setAttribute("aria-invalid", "true"));
        missing[0].focus();
        show("Please fill in your name, phone and a valid email.", "error");
        return;
      }

      button.disabled = true;
      show("Sending…", "ok");
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          form.reset();
          show("Thanks! Your message was sent. We'll be in touch soon.", "ok");
        } else {
          (data.invalid ?? []).forEach((name: string) =>
            form.querySelector(`[name="${name}"]`)?.setAttribute("aria-invalid", "true"),
          );
          show(data.error ?? "Sorry, your message couldn't be sent. Please try again.", "error");
        }
      } catch {
        show("Sorry, your message couldn't be sent. Please check your connection and try again.", "error");
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .hero {
    background: var(--cream);
    padding-block: 40px 48px;
  }

  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--muted);
    margin-bottom: 24px;
  }

  .crumbs a {
    color: var(--muted);
  }

  h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    margin: 10px 0 14px;
  }

  .hl {
    color: var(--orange-strong);
  }

  .hero .lede {
    max-width: 640px;
    margin: 0;
  }

  .body {
    padding-top: 48px;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 40px;
    align-items: start;
  }

  .form-card {
    padding: clamp(24px, 4vw, 40px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: var(--shadow);
  }

  .form-card h2 {
    margin: 0 0 4px;
  }

  .hint {
    margin: 0 0 24px;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 20px;
  }

  .fields label {
    display: grid;
    gap: 6px;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--ink);
  }

  .fields .full {
    grid-column: 1 / -1;
  }

  input,
  select,
  textarea {
    width: 100%;
    font: inherit;
    font-weight: 400;
    font-size: 1rem;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: #fff;
    color: var(--text);
  }

  textarea {
    resize: vertical;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: 2px solid var(--orange);
    outline-offset: 1px;
    border-color: transparent;
  }

  [aria-invalid="true"] {
    border-color: #c62828;
    background: #fff6f6;
  }

  .status {
    min-height: 1.5em;
    margin: 18px 0 12px;
    font-weight: 600;
  }

  .status[data-kind="ok"] {
    color: #1b6b3a;
  }

  .status[data-kind="error"] {
    color: #b3261e;
  }

  button[disabled] {
    opacity: 0.6;
    cursor: wait;
  }

  .fine {
    margin: 14px 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .fine a {
    color: var(--navy);
  }

  .side {
    display: grid;
    gap: 24px;
  }

  .info {
    padding: 26px;
    border-radius: var(--radius);
    background: var(--cream);
  }

  .info h2 {
    font-size: 1.25rem;
    margin: 0 0 14px;
  }

  .info ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }

  .info li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .info a {
    color: var(--navy);
  }

  .phones li {
    justify-content: space-between;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }

  .phones li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .phones .tel {
    font-weight: 700;
    color: var(--orange-ink);
    white-space: nowrap;
    text-decoration: none;
  }

  .reasons {
    background: var(--cream);
  }

  .reason-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .reason-grid li {
    padding: 28px 24px;
    border-radius: var(--radius);
    background: var(--paper);
  }

  .r-icon {
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--orange-soft);
    color: var(--orange-ink);
    margin-bottom: 16px;
  }

  .reason-grid h3 {
    font-size: 1.15rem;
    margin: 0 0 6px;
  }

  .reason-grid p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .reason-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .fields {
      grid-template-columns: 1fr;
    }
  }
</style>
