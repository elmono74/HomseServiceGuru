---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import CallButton from "../components/CallButton.astro";
import GuideCard from "../components/GuideCard.astro";
import { formatDate, posts, type Post } from "../data/posts";

// One article per old blog post, at the same top-level address as on WordPress.
export function getStaticPaths() {
  return posts.map((post) => ({ params: { post: post.slug }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post: p } = Astro.props;
const s = p.service;
const lower = s?.name.toLowerCase();
const related = [
  ...posts.filter((o) => o !== p && s && o.service === s),
  ...posts.filter((o) => o !== p && o.category === p.category && o.service !== s),
].slice(0, 3);
const url = new URL(`/${p.slug}/`, Astro.site).href;
const description = p.excerpt || `${p.title}: a Home Services Guru guide.`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: p.title,
    description,
    datePublished: p.date,
    dateModified: p.updated,
    mainEntityOfPage: url,
    publisher: { "@type": "Organization", name: "Home Services Guru", url: "https://homeservices.guru/" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://homeservices.guru/" },
      { "@type": "ListItem", position: 2, name: "Guides", item: "https://homeservices.guru/blog/" },
      { "@type": "ListItem", position: 3, name: p.title, item: url },
    ],
  },
];
---

<Base
  title={`${p.title} | Home Services Guru`}
  description={description}
  phone={s?.phone}
  phoneDisplay={s?.phoneDisplay}
  serviceName={s?.name}
  schema={schema}
>
  <section class="post-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span>
        <a href="/blog/">Guides</a> <span aria-hidden="true">/</span>
        <a href={`/category/${p.category}/`}>{p.categoryName}</a>
      </nav>
      <h1>{p.title}</h1>
      <p class="meta">
        <time datetime={p.date}>{formatDate(p.date)}</time>
        {p.updated > p.date && <span>Updated {formatDate(p.updated)}</span>}
      </p>
    </div>
  </section>

  <div class:list={["wrap layout", { solo: !s }]}>
    <article>
      {
        p.image && (
          <Image
            src={p.image}
            alt={p.imageAlt}
            class="lead-img"
            widths={[480, 760, 1140]}
            sizes="(max-width: 800px) 100vw, 760px"
            loading="eager"
          />
        )
      }
      <div class="prose" set:html={p.html} />

      <aside class="cta">
        <div>
          <h2>{s ? `Need help with ${lower}?` : "Need a hand at home?"}</h2>
          <p>
            {
              s
                ? `One free call connects you with a local ${lower} pro.`
                : "Tell us what's wrong and we'll connect you with a local pro."
            }
          </p>
        </div>
        {
          s ? (
            <CallButton phone={s.phone} phoneDisplay={s.phoneDisplay} serviceName={s.name} variant="light" size="lg" />
          ) : (
            <a class="btn btn-light btn-lg" href="/#find-a-pro">
              <Icon name="phone-call" /> Find my pro
            </a>
          )
        }
      </aside>
    </article>

    {
      s && (
        <aside class="side">
          <div class="side-card">
            <span class="side-icon">
              <Icon name={s.icon} size={26} />
            </span>
            <h2>{s.name}</h2>
            <p>{s.short}</p>
            <CallButton phone={s.phone} phoneDisplay={s.phoneDisplay} serviceName={s.name} />
            <a class="more" href={`/services/${s.slug}/`}>
              About {lower} help <Icon name="arrow" size={18} />
            </a>
          </div>
        </aside>
      )
    }
  </div>

  {
    related.length > 0 && (
      <section class="related">
        <div class="wrap">
          <h2>More guides</h2>
          <div class="grid">
            {related.map((r) => (
              <GuideCard guide={r} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .post-hero {
    background: var(--cream);
    padding-block: 40px 44px;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--muted);
    margin-bottom: 20px;
  }

  .crumbs a {
    color: var(--muted);
  }

  h1 {
    max-width: 820px;
    font-size: clamp(2rem, 4.2vw, 3rem);
    margin: 0 0 14px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 760px) 300px;
    justify-content: space-between;
    gap: 56px;
    padding-block: 48px clamp(56px, 8vw, 96px);
  }

  .layout.solo {
    grid-template-columns: minmax(0, 760px);
    justify-content: start;
  }

  .layout :global(.lead-img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 36px;
  }

  /* Article body copied from WordPress */
  .prose {
    font-size: 1.06rem;
    line-height: 1.75;
  }

  .prose :global(> :first-child) {
    margin-top: 0;
  }

  .prose :global(h2) {
    font-size: 1.6rem;
    margin: 2em 0 0.6em;
  }

  .prose :global(h3) {
    font-size: 1.25rem;
    margin: 1.8em 0 0.5em;
  }

  .prose :global(h4),
  .prose :global(h5),
  .prose :global(h6) {
    font-size: 1.08rem;
    margin: 1.6em 0 0.4em;
  }

  .prose :global(p),
  .prose :global(li) {
    color: var(--text);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3em;
    margin: 0 0 1.3em;
    display: grid;
    gap: 6px;
  }

  .prose :global(li::marker) {
    color: var(--orange-strong);
  }

  .prose :global(a) {
    color: var(--navy);
    text-underline-offset: 3px;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }

  .prose :global(.img-row) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 1.6em 0;
  }

  .prose :global(.img-row img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .prose :global(blockquote) {
    margin: 1.6em 0;
    padding: 4px 0 4px 22px;
    border-left: 4px solid var(--orange);
    font-size: 1.15rem;
    color: var(--ink);
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 2.2em 0;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.6em 0;
    font-size: 0.95rem;
    display: block;
    overflow-x: auto;
  }

  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--line);
    padding: 10px 12px;
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    background: var(--cream);
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 48px;
    padding: 28px 32px;
    border-radius: 24px;
    background: linear-gradient(120deg, var(--orange-strong), var(--orange));
    color: #fff;
  }

  .cta h2 {
    color: #fff;
    font-size: 1.5rem;
    margin: 0 0 4px;
  }

  .cta p {
    margin: 0;
  }

  .side-card {
    position: sticky;
    top: 104px;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: var(--shadow);
  }

  .side-icon {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--orange-soft);
    color: var(--orange-ink);
    margin-bottom: 14px;
  }

  .side-card h2 {
    font-size: 1.3rem;
    margin: 0 0 6px;
  }

  .side-card p {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0 0 18px;
  }

  .side-card :global(.btn) {
    width: 100%;
    justify-content: center;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--navy);
  }

  .related {
    background: var(--cream);
    padding-block: clamp(56px, 8vw, 88px);
  }

  .related h2 {
    margin: 0 0 28px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  @media (max-width: 1000px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .side {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .cta {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
      padding: 26px 22px;
    }

    .cta :global(.btn) {
      justify-content: center;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .prose :global(.img-row) {
      grid-template-columns: 1fr;
    }
  }
</style>
