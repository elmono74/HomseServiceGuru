---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import HowItWorks from "../components/HowItWorks.astro";
import pro from "../assets/about-pro.png";
import mascot from "../assets/guru-mascot.png";

// Content from the old WordPress About Us page, reworded where it made claims about
// providers (pre-screened, carefully selected, top providers, fair prices).
const reasons = [
  {
    icon: "pin",
    title: "Local Expertise",
    text: "We connect you with professionals in your community who understand your needs.",
  },
  {
    icon: "handshake",
    title: "Any Size Job",
    text: "From a quick repair to a full remodel, one call gets you started.",
  },
  {
    icon: "clock",
    title: "Time-Saving Convenience",
    text: "Skip the stress of searching. One call gets you the right pro.",
  },
  {
    icon: "wallet",
    title: "Free to Call",
    text: "Calling us costs nothing, and there's no obligation.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Home Services Guru",
    url: "https://homeservices.guru/",
    email: "info@homeservices.guru",
    address: {
      "@type": "PostalAddress",
      streetAddress: "530 S Lake St #250",
      addressLocality: "Pasadena",
      addressRegion: "CA",
      postalCode: "91101",
      addressCountry: "US",
    },
  },
];
---

<Base
  title="About Us | Home Services Guru"
  description="Home Services Guru makes finding local home service professionals quick, easy and stress-free. One call connects you with a local specialist."
  schema={schema}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true">/</span> <span aria-current="page">About us</span>
        </nav>
        <span class="eyebrow">About our company</span>
        <h1>Your home service <span class="hl">guru.</span></h1>
        <p class="lede">
          At Home Services Guru, our mission is simple: to make finding trusted home service professionals quick, easy,
          and stress-free.
        </p>
        <p>
          We know how frustrating it can be to search through endless listings, compare reviews, and worry about whether
          you're hiring the right person. That's why we created a better way. Instead of spending hours looking for help,
          one call to us connects you directly with local specialists in your area. From HVAC repairs and plumbing
          emergencies to roofing, remodeling, pest control, and more, we help you get the help you need.
        </p>
        <dl class="stats">
          <div>
            <dt>1,250+</dt>
            <dd>Satisfied clients</dd>
          </div>
          <div>
            <dt>5+</dt>
            <dd>Years helping people find local service providers</dd>
          </div>
        </dl>
      </div>
      <figure class="photo">
        <Image src={pro} alt="" widths={[320, 480, 640]} sizes="(max-width: 860px) 70vw, 420px" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <div class="card">
        <h2>Our commitment</h2>
        <p>
          At Home Services Guru, we're not just about making connections. We're about building trust. We believe every
          homeowner deserves peace of mind when something goes wrong at home. That's why we focus on making it fast and
          easy to reach a local pro.
        </p>
      </div>
      <div class="card">
        <h2>Why Home Services Guru</h2>
        <p>
          When something goes wrong at home, you don't have time to waste searching for the right help. That's why you
          should call Home Services Guru. We do the hard work for you. With one quick call, you'll be connected with a
          local specialist who can help.
        </p>
      </div>
    </div>
  </section>

  <section class="section reasons">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow">Why homeowners call us</span>
        <h2>We connect you with local home service providers.</h2>
      </div>
      <ul class="reason-grid">
        {
          reasons.map((r) => (
            <li>
              <span class="r-icon">
                <Icon name={r.icon} />
              </span>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <HowItWorks />

  <section class="section contact">
    <div class="wrap contact-box">
      <Image src={mascot} alt="" width={200} class="guru" />
      <div>
        <h2>Get in touch</h2>
        <ul class="contact-list">
          <li><Icon name="pin" size={20} /> 530 S Lake St #250, Pasadena, CA 91101</li>
          <li>
            <Icon name="chat" size={20} /> <a href="mailto:info@homeservices.guru">info@homeservices.guru</a>
          </li>
        </ul>
      </div>
      <a class="btn btn-light btn-lg" href="/#find-a-pro"><Icon name="phone-call" /> Find my pro</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: var(--cream);
    padding-block: 40px 0;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 420px;
    gap: 48px;
    align-items: end;
  }

  .hero-grid > div {
    padding-bottom: clamp(40px, 6vw, 72px);
  }

  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--muted);
    margin-bottom: 24px;
  }

  .crumbs a {
    color: var(--muted);
  }

  h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    margin: 10px 0 16px;
  }

  .hl {
    color: var(--orange-strong);
  }

  .hero p {
    max-width: 620px;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin: 32px 0 0;
  }

  .stats dt {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 800;
    color: var(--orange-strong);
    line-height: 1;
  }

  .stats dd {
    margin: 6px 0 0;
    max-width: 200px;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .photo {
    margin: 0;
  }

  .photo :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .card {
    padding: clamp(24px, 4vw, 40px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: var(--shadow);
  }

  .card h2 {
    font-size: 1.6rem;
  }

  .card p {
    margin: 0;
    color: var(--text);
  }

  .reasons {
    background: var(--cream);
  }

  .reason-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  .reason-grid li {
    padding: 28px 24px;
    border-radius: var(--radius);
    background: var(--paper);
  }

  .r-icon {
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--orange-soft);
    color: var(--orange-ink);
    margin-bottom: 16px;
  }

  .reason-grid h3 {
    font-size: 1.15rem;
    margin: 0 0 6px;
  }

  .reason-grid p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .contact {
    padding-block: 30px;
  }

  .contact-box {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 32px;
    align-items: center;
    padding: 28px 40px;
    border-radius: 28px;
    background: linear-gradient(120deg, var(--orange-strong), var(--orange));
    color: #fff;
  }

  .contact-box h2 {
    color: #fff;
    margin-bottom: 10px;
  }

  .contact-box :global(.guru) {
    width: 140px;
    margin-block: -48px -20px;
    filter: drop-shadow(0 12px 24px rgb(0 0 0 / 20%));
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }

  .contact-list li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .contact-list a {
    color: #fff;
  }

  @media (max-width: 1000px) {
    .reason-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .photo {
      width: min(70%, 340px);
      margin-inline: auto;
    }

    .two-col {
      grid-template-columns: 1fr;
    }

    .contact-box {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 32px 24px;
    }

    .contact-box :global(.guru) {
      margin: -48px auto 0;
      width: 120px;
    }

    .contact-list li {
      justify-content: center;
    }
  }

  @media (max-width: 560px) {
    .reason-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
