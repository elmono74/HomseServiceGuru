---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CallBar from "../components/CallBar.astro";
import ChatWidget from "../components/ChatWidget.astro";

interface Props {
  title: string;
  description: string;
  phone?: string | null;
  phoneDisplay?: string;
  serviceName?: string;
  schema?: object[];
}

const { title, description, phone, phoneDisplay, serviceName, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL("/og-image.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Home Services Guru" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Home Services Guru: one call connects you with a local pro." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ff6b00" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="144x144" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header phone={phone} phoneDisplay={phoneDisplay} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ChatWidget />
    <CallBar phone={phone} phoneDisplay={phoneDisplay} serviceName={serviceName} />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 10px;
    background: var(--ink);
    color: #fff;
  }

  .skip:focus {
    top: 12px;
  }
</style>
