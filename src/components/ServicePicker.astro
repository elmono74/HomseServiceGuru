---
import Icon from "./Icon.astro";
import { services, telHref } from "../data/services";

// Homepage hero widget: there's no single company number, so the visitor picks a
// service and gets that service's tracking number (or a callback link). Below it,
// visitors can type their problem instead; that opens the chat (ChatWidget) with it.
const options = services.map((s) => ({
  slug: s.slug,
  name: s.name,
  tel: s.phone ? telHref(s.phone) : "",
  display: s.phoneDisplay ?? "",
}));
---

<form class="picker" id="find-a-pro" data-options={JSON.stringify(options)} action="/services/" method="get">
  <label for="service-select">What do you need help with?</label>
  <div class="row">
    <div class="select">
      <select id="service-select" name="service">
        <option value="" selected disabled>Choose a service…</option>
        {services.map((s) => <option value={s.slug}>{s.name}</option>)}
      </select>
      <Icon name="chevron" size={20} />
    </div>
    <a class="btn btn-call btn-lg go" href="#services" aria-live="polite">
      <Icon name="phone-call" />
      <span class="go-label">See your number</span>
    </a>
  </div>
  <div class="ask-guru">
    <input
      type="text"
      name="ask"
      maxlength="500"
      autocomplete="off"
      enterkeyhint="send"
      placeholder="Or just tell the Guru what's wrong…"
      aria-label="Tell the Guru what's wrong"
    />
    <button type="button" class="ask-go"><Icon name="chat" size={20} /> <span>Ask</span></button>
  </div>
  <p class="note"><Icon name="badge" size={18} /> Free to call · Local pros near you</p>
</form>

<script>
  type Option = { slug: string; name: string; tel: string; display: string };
  const form = document.querySelector<HTMLFormElement>("#find-a-pro");
  if (form) {
    const options: Option[] = JSON.parse(form.dataset.options ?? "[]");
    const select = form.querySelector("select")!;
    const go = form.querySelector<HTMLAnchorElement>(".go")!;
    const label = form.querySelector(".go-label")!;
    select.addEventListener("change", () => {
      const o = options.find((x) => x.slug === select.value);
      if (!o) return;
      if (o.tel) {
        go.href = o.tel;
        label.textContent = `Call ${o.display}`;
      } else {
        go.href = `/services/${o.slug}/`;
        label.textContent = `Get ${o.name} help`;
      }
      // The sticky phone call bar (CallBar) follows the pick.
      document.dispatchEvent(new CustomEvent("service-picked", { detail: o }));
    });
    form.addEventListener("submit", (e) => e.preventDefault());

    // "Tell the Guru": hand the text to the chat widget, which opens and sends it.
    const ask = form.querySelector<HTMLInputElement>(".ask-guru input")!;
    const askGuru = () => {
      document.dispatchEvent(new CustomEvent("ask-guru", { detail: { text: ask.value } }));
      ask.value = "";
    };
    form.querySelector(".ask-go")!.addEventListener("click", askGuru);
    ask.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        askGuru();
      }
    });
  }
</script>

<style>
  .picker {
    background: #fff;
    border-radius: 22px;
    padding: 22px;
    box-shadow: var(--shadow-lg);
    max-width: 600px;
  }

  label {
    display: block;
    font-family: var(--font-display);
    font-weight: 750;
    color: var(--ink);
    margin-bottom: 12px;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(200px, 1fr) auto;
    gap: 10px;
  }

  .select {
    position: relative;
  }

  select {
    appearance: none;
    width: 100%;
    height: 60px;
    padding: 0 48px 0 18px;
    border: 2px solid var(--line);
    border-radius: 14px;
    background: var(--cream);
    font: inherit;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
  }

  .select :global(svg) {
    position: absolute;
    right: 16px;
    top: 50%;
    translate: 0 -50%;
    pointer-events: none;
    color: var(--muted);
  }

  .go {
    border-radius: 14px;
    min-width: 0;
    padding: 0 22px;
  }

  .ask-guru {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
    margin-top: 10px;
  }

  .ask-guru input {
    width: 100%;
    height: 56px;
    padding: 0 18px;
    border: 2px dashed var(--line);
    border-radius: 14px;
    background: #fff;
    font: inherit;
    color: var(--ink);
  }

  .ask-guru input::placeholder {
    color: var(--muted);
  }

  .ask-guru input:focus {
    outline: 2px solid var(--orange);
    outline-offset: 1px;
    border-color: transparent;
  }

  .ask-go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 20px;
    border: 0;
    border-radius: 14px;
    background: var(--navy);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
  }

  .ask-go:hover {
    background: #0c2436;
  }

  .note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 14px 0 0;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .note :global(svg) {
    color: var(--teal);
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
    }
    .go {
      min-width: 0;
    }
    .ask-guru {
      grid-template-columns: 1fr;
    }
    /* Typed text stays 16px so iPhones don't zoom in on focus; only the hint shrinks. */
    .ask-guru input {
      padding: 0 12px;
    }
    .ask-guru input::placeholder {
      font-size: 0.94rem;
    }
    .ask-go {
      justify-content: center;
      height: 52px;
    }
  }
</style>
