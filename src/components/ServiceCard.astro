---
import Icon from "./Icon.astro";
import type { Service } from "../data/services";

interface Props {
  service: Service;
}

const { service: s } = Astro.props;
---

<a class="card" href={`/services/${s.slug}/`}>
  <span class="icon"><Icon name={s.icon} size={26} /></span>
  <span class="body">
    <span class="name">{s.name}</span>
    <span class="short">{s.short}</span>
  </span>
  <span class="go" aria-hidden="true"><Icon name="arrow" size={20} /></span>
  {s.emergency && <span class="tag">Emergency</span>}
</a>

<style>
  .card {
    position: relative;
    display: grid;
    grid-template-columns: 52px 1fr 24px;
    gap: 16px;
    align-items: center;
    padding: 20px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .card:hover {
    border-color: transparent;
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--orange-soft);
    color: var(--orange-ink);
  }

  .name {
    display: block;
    font-family: var(--font-display);
    font-weight: 750;
    font-size: 1.08rem;
    color: var(--ink);
  }

  .short {
    display: block;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .go {
    color: var(--muted);
    transition: transform 0.15s ease;
  }

  .card:hover .go {
    color: var(--orange-ink);
    transform: translateX(3px);
  }

  /* Phones: compact icon tiles, two per row */
  @media (max-width: 560px) {
    .card {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 16px;
      align-content: start;
    }
    .short,
    .go {
      display: none;
    }
    .name {
      font-size: 0.98rem;
      line-height: 1.25;
    }
    .icon {
      width: 44px;
      height: 44px;
    }
  }

  .tag {
    position: absolute;
    top: 12px;
    right: 14px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--navy);
    background: #e3f2f8;
    padding: 2px 8px;
    border-radius: 999px;
  }
</style>
