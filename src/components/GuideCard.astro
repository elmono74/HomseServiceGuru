---
import { Image } from "astro:assets";
import mascot from "../assets/guru-mascot.png";
import { formatDate, type Post } from "../data/posts";

interface Props {
  guide: Post;
}

const { guide: g } = Astro.props;
---

<article class="guide">
  <a href={`/${g.slug}/`} class:list={["img", { placeholder: !g.image }]} tabindex="-1" aria-hidden="true">
    {
      g.image ? (
        <Image src={g.image} alt="" width={600} height={390} />
      ) : (
        <Image src={mascot} alt="" width={160} />
      )
    }
  </a>
  <div class="meta">
    <span class="cat">{g.service?.name ?? g.categoryName}</span>
    <time datetime={g.date}>{formatDate(g.date)}</time>
  </div>
  <h3><a href={`/${g.slug}/`}>{g.title}</a></h3>
  <p>{g.excerpt}</p>
</article>

<style>
  .guide {
    display: flex;
    flex-direction: column;
  }

  .img {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    margin-bottom: 16px;
    aspect-ratio: 20 / 13;
  }

  .img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .img.placeholder {
    display: grid;
    place-items: center;
    background: var(--cream);
  }

  .img.placeholder img {
    width: 34%;
    height: auto;
    object-fit: contain;
  }

  .guide:hover .img img {
    transform: scale(1.04);
  }

  .meta {
    display: flex;
    gap: 12px;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 6px;
  }

  .cat {
    font-weight: 650;
    color: var(--orange-ink);
  }

  h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
  }

  p {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0;
  }
</style>
