---
import { Image } from "astro:assets";
import type { guides } from "../data/guides";
import { services } from "../data/services";

interface Props {
  guide: (typeof guides)[number];
}

const { guide: g } = Astro.props;
const service = services.find((s) => s.slug === g.service);
const date = new Date(g.date + "T12:00:00").toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
---

<article class="guide">
  <a href={`/${g.slug}/`} class="img">
    <Image src={g.image} alt="" width={600} height={390} />
  </a>
  <div class="meta">
    {service && <span class="cat">{service.name}</span>}
    <time datetime={g.date}>{date}</time>
  </div>
  <h3><a href={`/${g.slug}/`}>{g.title}</a></h3>
  <p>{g.excerpt}</p>
</article>

<style>
  .guide {
    display: flex;
    flex-direction: column;
  }

  .img {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    margin-bottom: 16px;
    aspect-ratio: 20 / 13;
  }

  .img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .guide:hover .img img {
    transform: scale(1.04);
  }

  .meta {
    display: flex;
    gap: 12px;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 6px;
  }

  .cat {
    font-weight: 650;
    color: var(--orange-ink);
  }

  h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
  }

  p {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0;
  }
</style>
