// Cloudflare Workers config. Workers Builds runs `npm run build`, then
// `npx wrangler deploy` with this file.
{
  "name": "homeguru",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve dist/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page",
    // Only the chat API runs Worker code; everything else is served as static files.
    "run_worker_first": ["/api/*"]
  },
  // Per-IP limit on chat requests so bots can't run up the Claude bill.
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 }
    }
  ]
  // Secret (set once, not in this file): npx wrangler secret put ANTHROPIC_API_KEY
}
